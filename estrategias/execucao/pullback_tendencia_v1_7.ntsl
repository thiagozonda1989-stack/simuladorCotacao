{ Pesquisa v1.7. v1.5 com adendo opcional de falha de rompimento em OHLC de 1 min. }

input
  p_Rapida(9);
  p_Lenta(34);
  p_Alvo(150);
  p_UsarAlvoDinamico(1);
  p_JanelaAmplitude(10);
  p_FatorAmplitude(1.0);
  p_AlvoMin(50);
  p_AlvoMax(220);
  p_Rompimento(1);
  p_Stop(75);
  p_FatorStop(0.65);
  p_FolgaStop(50);
  p_TempoMax(30);
  p_MaxEntradasDia(4);
  p_Espera(3);
  p_PerdaMaxDia(150);        { em reais: DailyResult já aplica valor do ponto e custos }
  p_HoraInicio(930);
  p_HoraFimEntradas(1700);
  p_HoraZeragem(1745);
  p_AtivarSaidaFalha(0);
  p_JanelaFalha(1);
  p_ToleranciaFalhaTicks(0);

var
  v_Rapida, v_Lenta : Float;
  v_Alvo, v_AlvoSinal, v_Amplitude, v_AmplitudeMedia, v_StopSinal, v_Stop, v_Folga : Float;
  v_DataContagem : Integer;
  v_TendAlta, v_TendBaixa : Boolean;
  v_SinalCompra, v_SinalVenda : Boolean;
  v_Posicionado, v_EstavaPosicionado : Boolean;
  v_PodeEntrar, v_Zerar : Boolean;
  v_BarraEntrada, v_BarraSaida, v_EntradasDia : Integer;
  v_NivelFalha : Float;
  v_BarraSinalFalha, v_DataSinalFalha, v_MinutoSinalFalha, v_Minuto, v_Fechados : Integer;
  v_SairPorFalha : Boolean;

begin
  v_Rapida := Media(p_Rapida, Close);
  v_Lenta := Media(p_Lenta, Close);

  { niveis sempre na grade de 5 pontos }
  v_Amplitude := High - Low;
  v_AmplitudeMedia := Media(p_JanelaAmplitude, v_Amplitude);
  v_AlvoSinal := p_Alvo;
  if p_UsarAlvoDinamico = 1 then
  begin
    v_AlvoSinal := v_AmplitudeMedia * p_FatorAmplitude;
    if v_AlvoSinal < p_AlvoMin then v_AlvoSinal := p_AlvoMin;
    if v_AlvoSinal > p_AlvoMax then v_AlvoSinal := p_AlvoMax;
  end;
  v_AlvoSinal := Round(v_AlvoSinal / 5) * 5;
  v_StopSinal := v_AmplitudeMedia * p_FatorStop;
  if v_StopSinal < 50 then v_StopSinal := 50;
  if v_StopSinal > p_Stop then v_StopSinal := p_Stop;
  v_StopSinal := Round(v_StopSinal / 5) * 5;
  v_Folga := Round(p_FolgaStop / 5) * 5;

  v_TendAlta := (v_Rapida > v_Lenta) and (v_Rapida > v_Rapida[1]);
  v_TendBaixa := (v_Rapida < v_Lenta) and (v_Rapida < v_Rapida[1]);
  v_SinalCompra := v_TendAlta and (Low <= v_Rapida) and (Close > v_Rapida) and (Close > Open)
                   and (Close > Close[1]) and ((p_Rompimento = 0) or (Close > High[1])) and (High > Low)
                   and (Close - Low >= 0.65 * (High - Low));
  v_SinalVenda := v_TendBaixa and (High >= v_Rapida) and (Close < v_Rapida) and (Close < Open)
                  and (Close < Close[1]) and ((p_Rompimento = 0) or (Close < Low[1])) and (High > Low)
                  and (High - Close >= 0.65 * (High - Low));

  if Date <> v_DataContagem then
  begin
    v_EntradasDia := 0;
    v_DataContagem := Date;
  end;

  v_Posicionado := IsBought or IsSold;
  if v_Posicionado and (not v_EstavaPosicionado) then
    v_BarraEntrada := CurrentBar;
  if v_EstavaPosicionado and (not v_Posicionado) then
    v_BarraSaida := CurrentBar;

  v_Zerar := (Time >= p_HoraZeragem)
             or (v_Posicionado and (CurrentBar - v_BarraEntrada >= p_TempoMax));

  v_PodeEntrar := (not v_Posicionado)
                  and (CurrentBar > p_Lenta + 2)
                  and (CurrentBar > p_JanelaAmplitude)
                  and (Time >= p_HoraInicio) and (Time <= p_HoraFimEntradas)
                  and (v_EntradasDia < p_MaxEntradasDia)
                  and (CurrentBar >= v_BarraSaida + p_Espera)
                  and (DailyResult > -p_PerdaMaxDia);

  v_SairPorFalha := False;
  if (p_AtivarSaidaFalha = 1) and v_Posicionado and (v_NivelFalha > 0) then
  begin
    { A avaliação extra após a entrada reutiliza o rótulo do sinal, com zero fechamentos. }
    v_Fechados := CurrentBar - v_BarraSinalFalha;
    if v_Fechados > 0 then
    begin
      v_Minuto := Time - 40 * Floor(Time / 100);
      if (Date <> v_DataSinalFalha) or (v_Minuto - v_MinutoSinalFalha <> v_Fechados) then
        v_NivelFalha := 0;
      if (v_NivelFalha > 0) and (v_Fechados <= p_JanelaFalha) then
        v_SairPorFalha := (IsBought and (Close < v_NivelFalha - 5 * p_ToleranciaFalhaTicks))
                          or (IsSold and (Close > v_NivelFalha + 5 * p_ToleranciaFalhaTicks));
    end;
  end;

  if v_Posicionado and (v_Zerar or v_SairPorFalha) then
  begin
    if v_SairPorFalha and (not v_Zerar) then
    begin
      if HasPendingOrders then CancelPendingOrders;
      Plot4(1);
    end;
    if IsBought then SellToCoverAtMarket(2)
    else BuyToCoverAtMarket(2);
  end
  else if IsBought then
  begin
    SellToCoverLimit(BuyPrice + v_Alvo, 2);
    SellToCoverStop(BuyPrice - v_Stop, BuyPrice - v_Stop - v_Folga, 2);
  end
  else if IsSold then
  begin
    BuyToCoverLimit(SellPrice - v_Alvo, 2);
    BuyToCoverStop(SellPrice + v_Stop, SellPrice + v_Stop + v_Folga, 2);
  end
  else if v_PodeEntrar then
  begin
    if v_SinalCompra then
    begin
      v_Alvo := v_AlvoSinal;
      v_Stop := v_StopSinal;
      if p_AtivarSaidaFalha = 1 then
      begin
        v_NivelFalha := 0;
        if p_Rompimento = 1 then v_NivelFalha := High[1];
        v_BarraSinalFalha := CurrentBar;
        v_DataSinalFalha := Date;
        v_MinutoSinalFalha := Time - 40 * Floor(Time / 100);
        Plot5(v_NivelFalha);
      end;
      BuyAtMarket(2);
      v_EntradasDia := v_EntradasDia + 1;
    end
    else if v_SinalVenda then
    begin
      v_Alvo := v_AlvoSinal;
      v_Stop := v_StopSinal;
      if p_AtivarSaidaFalha = 1 then
      begin
        v_NivelFalha := 0;
        if p_Rompimento = 1 then v_NivelFalha := Low[1];
        v_BarraSinalFalha := CurrentBar;
        v_DataSinalFalha := Date;
        v_MinutoSinalFalha := Time - 40 * Floor(Time / 100);
        Plot5(v_NivelFalha);
      end;
      SellShortAtMarket(2);
      v_EntradasDia := v_EntradasDia + 1;
    end;
  end;

  v_EstavaPosicionado := v_Posicionado;
  Plot(v_Rapida);
  Plot2(v_Lenta);
  Plot3(v_AlvoSinal);
end;
