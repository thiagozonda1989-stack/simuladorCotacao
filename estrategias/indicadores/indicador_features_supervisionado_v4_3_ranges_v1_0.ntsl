  Plot56(v_FlagPressaoSaidaLong);
  Plot57(v_FlagPressaoSaidaShort);
  Plot58(v_FlagPressaoSaidaLongBarra);
  Plot59(v_FlagPressaoSaidaShortBarra);
  Plot60(v_FlagFiltroHorario);
  Plot61(v_FlagBookPermitido);
  Plot62(v_FlagUsarBookNoScore);
  Plot63(v_CorpoFechado);
  Plot64(v_RetornoFechado);
