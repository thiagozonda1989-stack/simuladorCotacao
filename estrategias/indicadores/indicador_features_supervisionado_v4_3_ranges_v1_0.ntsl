  Plot12(v_TradesAtual);
  Plot13(v_TradesAtual[1]);
  Plot14(v_AgressaoCompra);
  Plot15(v_AgressaoVenda);
  Plot16(v_DeltaAgressao);
  Plot17(v_RazaoAgressaoAssinada);
  Plot18(v_VariacaoDeltaAgressao);
  Plot19(v_AgressaoCompraFechada);
  Plot20(v_AgressaoVendaFechada);
  Plot21(v_Bid);
  Plot22(v_Ask);
  Plot23(v_SpreadTicks);
  Plot24(v_QtdBid);
  Plot25(v_QtdAsk);
  Plot26(v_ImbalanceTopo);
