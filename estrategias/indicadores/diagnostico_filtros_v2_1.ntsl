{ ============================================================================ }
{ INDICADOR: diagnostico_filtros_v2_1                                      }
{ NAO ENVIA ORDENS. Mostra quais filtros da estrategia estao sendo ativados. }
{ Usar no WIN em grafico de 5 segundos durante o Replay.                     }
{ ============================================================================ }

input
  p_SegundosPorBarra(5);
  p_MinVelocidade(2.0);
  p_MinAceleracao(0.2);
  p_MinForcaContratos(10.0);
  p_RazaoDesbalanco(1.5);
  p_MinTradesBarra(5);
  p_PeriodoMediaPreco(9);
  p_HorarioInicio(0915);
  p_HorarioFimEntradas(1700);
  p_MultiplicadorVisual(0.20);

var
  v_VariacaoPreco       : Float;
  v_PercursoCompra      : Float;
  v_PercursoVenda       : Float;
  v_VelocidadeCompra    : Float;
  v_VelocidadeVenda     : Float;
  v_AceleracaoCompra    : Float;
  v_AceleracaoVenda     : Float;
  v_VolumeAgressaoCompra: Float;
  v_VolumeAgressaoVenda : Float;
  v_ForcaCompra         : Float;
  v_ForcaVenda          : Float;
  v_MediaPreco          : Float;

  v_FiltroHorario       : Boolean;
  v_DensidadeOK         : Boolean;
  v_VelocidadeOK        : Boolean;
  v_AceleracaoOK        : Boolean;
  v_ForcaMinimaOK       : Boolean;
  v_DesbalancoOK        : Boolean;
  v_DirecaoPrecoOK      : Boolean;
  v_SinalCompleto       : Boolean;

  v_IndicadorHorario    : Float;
  v_IndicadorDensidade  : Float;
  v_IndicadorVelocidade : Float;
  v_IndicadorAceleracao : Float;
  v_IndicadorForca      : Float;
  v_IndicadorDesbalanco : Float;
  v_IndicadorDirecao    : Float;
  v_IndicadorSinal      : Float;

begin
  v_FiltroHorario :=
    (Time >= p_HorarioInicio)
    and (Time < p_HorarioFimEntradas);
  v_DensidadeOK := Trades >= p_MinTradesBarra;

  v_VariacaoPreco := Close - Close[1];

  if v_VariacaoPreco > 0 then
  begin
    v_PercursoCompra := v_VariacaoPreco;
    v_PercursoVenda  := 0;
  end
  else if v_VariacaoPreco < 0 then
  begin
    v_PercursoCompra := 0;
    v_PercursoVenda  := Abs(v_VariacaoPreco);
  end
  else
  begin
    v_PercursoCompra := 0;
    v_PercursoVenda  := 0;
  end;

  if p_SegundosPorBarra > 0 then
  begin
    v_VelocidadeCompra := v_PercursoCompra / p_SegundosPorBarra;
    v_VelocidadeVenda  := v_PercursoVenda / p_SegundosPorBarra;
    v_AceleracaoCompra :=
      (v_VelocidadeCompra - v_VelocidadeCompra[1])
      / p_SegundosPorBarra;
    v_AceleracaoVenda :=
      (v_VelocidadeVenda - v_VelocidadeVenda[1])
      / p_SegundosPorBarra;

    v_VolumeAgressaoCompra := AgressionVolBuy;
    v_VolumeAgressaoVenda  := AgressionVolSell;
    v_ForcaCompra := v_VolumeAgressaoCompra / p_SegundosPorBarra;
    v_ForcaVenda  := v_VolumeAgressaoVenda / p_SegundosPorBarra;
  end
  else
  begin
    v_VelocidadeCompra := 0;
    v_VelocidadeVenda  := 0;
    v_AceleracaoCompra := 0;
    v_AceleracaoVenda  := 0;
    v_ForcaCompra      := 0;
    v_ForcaVenda       := 0;
  end;

  v_MediaPreco := Media(p_PeriodoMediaPreco, Close);

  v_VelocidadeOK :=
    (v_VelocidadeCompra >= p_MinVelocidade)
    or (v_VelocidadeVenda >= p_MinVelocidade);

  v_AceleracaoOK :=
    ((v_VariacaoPreco > 0)
     and (v_AceleracaoCompra >= p_MinAceleracao))
    or
    ((v_VariacaoPreco < 0)
     and (v_AceleracaoVenda >= p_MinAceleracao));

  v_ForcaMinimaOK :=
    ((v_VariacaoPreco > 0)
     and (v_ForcaCompra >= p_MinForcaContratos))
    or
    ((v_VariacaoPreco < 0)
     and (v_ForcaVenda >= p_MinForcaContratos));

  v_DesbalancoOK :=
    ((v_VariacaoPreco > 0)
     and (v_ForcaCompra >= (p_RazaoDesbalanco * v_ForcaVenda)))
    or
    ((v_VariacaoPreco < 0)
     and (v_ForcaVenda >= (p_RazaoDesbalanco * v_ForcaCompra)));

  v_DirecaoPrecoOK :=
    ((v_VariacaoPreco > 0)
     and (Close > Open)
     and (Close > v_MediaPreco))
    or
    ((v_VariacaoPreco < 0)
     and (Close < Open)
     and (Close < v_MediaPreco));

  v_SinalCompleto :=
    v_FiltroHorario
    and v_DensidadeOK
    and v_VelocidadeOK
    and v_AceleracaoOK
    and v_ForcaMinimaOK
    and v_DesbalancoOK
    and v_DirecaoPrecoOK;

  { Converte cada filtro em intensidade normalizada entre zero e um. }
  if v_FiltroHorario then
    v_IndicadorHorario := 1
  else
    v_IndicadorHorario := 0;

  if p_MinTradesBarra > 0 then
    v_IndicadorDensidade := Trades / p_MinTradesBarra
  else
    v_IndicadorDensidade := 1;

  if v_VelocidadeCompra > v_VelocidadeVenda then
    v_IndicadorVelocidade := v_VelocidadeCompra
  else
    v_IndicadorVelocidade := v_VelocidadeVenda;

  if p_MinVelocidade > 0 then
    v_IndicadorVelocidade :=
      v_IndicadorVelocidade / p_MinVelocidade
  else
    v_IndicadorVelocidade := 1;

  if v_VariacaoPreco > 0 then
  begin
    v_IndicadorAceleracao := v_AceleracaoCompra;
    v_IndicadorForca      := v_ForcaCompra;

    if v_ForcaVenda > 0 then
      v_IndicadorDesbalanco :=
        v_ForcaCompra / v_ForcaVenda
    else if v_ForcaCompra > 0 then
      v_IndicadorDesbalanco := p_RazaoDesbalanco
    else
      v_IndicadorDesbalanco := 0;
  end
  else if v_VariacaoPreco < 0 then
  begin
    v_IndicadorAceleracao := v_AceleracaoVenda;
    v_IndicadorForca      := v_ForcaVenda;

    if v_ForcaCompra > 0 then
      v_IndicadorDesbalanco :=
        v_ForcaVenda / v_ForcaCompra
    else if v_ForcaVenda > 0 then
      v_IndicadorDesbalanco := p_RazaoDesbalanco
    else
      v_IndicadorDesbalanco := 0;
  end
  else
  begin
    v_IndicadorAceleracao := 0;
    v_IndicadorForca      := 0;
    v_IndicadorDesbalanco := 0;
  end;

  if p_MinAceleracao > 0 then
    v_IndicadorAceleracao :=
      v_IndicadorAceleracao / p_MinAceleracao
  else
    v_IndicadorAceleracao := 1;

  if p_MinForcaContratos > 0 then
    v_IndicadorForca :=
      v_IndicadorForca / p_MinForcaContratos
  else
    v_IndicadorForca := 1;

  if p_RazaoDesbalanco > 0 then
    v_IndicadorDesbalanco :=
      v_IndicadorDesbalanco / p_RazaoDesbalanco
  else
    v_IndicadorDesbalanco := 1;

  if v_DirecaoPrecoOK then
    v_IndicadorDirecao := 1
  else
    v_IndicadorDirecao := 0;

  if v_SinalCompleto then
    v_IndicadorSinal := 1
  else
    v_IndicadorSinal := 0;

  { Limita as intensidades para manter cada linha dentro da propria trilha. }
  if v_IndicadorDensidade > 1 then
    v_IndicadorDensidade := 1;
  if v_IndicadorDensidade < 0 then
    v_IndicadorDensidade := 0;

  if v_IndicadorVelocidade > 1 then
    v_IndicadorVelocidade := 1;
  if v_IndicadorVelocidade < 0 then
    v_IndicadorVelocidade := 0;

  if v_IndicadorAceleracao > 1 then
    v_IndicadorAceleracao := 1;
  if v_IndicadorAceleracao < 0 then
    v_IndicadorAceleracao := 0;

  if v_IndicadorForca > 1 then
    v_IndicadorForca := 1;
  if v_IndicadorForca < 0 then
    v_IndicadorForca := 0;

  if v_IndicadorDesbalanco > 1 then
    v_IndicadorDesbalanco := 1;
  if v_IndicadorDesbalanco < 0 then
    v_IndicadorDesbalanco := 0;

  { Trilhas 1 a 8, separadas; a variacao maxima padrao e de 0,20. }
  Plot (1 + (p_MultiplicadorVisual * v_IndicadorHorario));
  Plot2(2 + (p_MultiplicadorVisual * v_IndicadorDensidade));
  Plot3(3 + (p_MultiplicadorVisual * v_IndicadorVelocidade));
  Plot4(4 + (p_MultiplicadorVisual * v_IndicadorAceleracao));
  Plot5(5 + (p_MultiplicadorVisual * v_IndicadorForca));
  Plot6(6 + (p_MultiplicadorVisual * v_IndicadorDesbalanco));
  Plot7(7 + (p_MultiplicadorVisual * v_IndicadorDirecao));
  Plot8(8 + (p_MultiplicadorVisual * v_IndicadorSinal));

  { Cores distintas para identificar rapidamente cada trilha. }
  SetPlotColor(1, RGB(180, 180, 180));
  SetPlotColor(2, RGB(0, 200, 255));
  SetPlotColor(3, RGB(255, 220, 0));
  SetPlotColor(4, RGB(255, 140, 0));
  SetPlotColor(5, RGB(60, 120, 255));
  SetPlotColor(6, RGB(230, 60, 230));
  SetPlotColor(7, RGB(0, 220, 100));
  SetPlotColor(8, RGB(255, 255, 255));
end;
