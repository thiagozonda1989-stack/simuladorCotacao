{ Sonda de persistencia NTSL. Fixture sintetica para o simulador OHLC. }

input
  p_Data(1261026);
  p_HoraEntrada(1303);
  p_FimLog(1305);
  p_Stop(5);
  p_Offset(5);

var
  v_Anterior : Integer;
  v_Antes    : Integer;
  v_Seq      : Integer;

begin
  if (Date = p_Data) and (Time >= p_HoraEntrada) and (Time <= p_FimLog) then
  begin
    v_Seq := v_Seq + 1;
    v_Antes := v_Anterior;

    if IsBought then
      SellToCoverStop(BuyPrice - p_Stop, BuyPrice - p_Stop - p_Offset, 1)
    else if (Time = p_HoraEntrada) and not HasPendingOrders then
      BuyAtMarket(1);

    if IsBought then
      v_Anterior := 1
    else
      v_Anterior := 0;

    ConsoleLog("PERSISTENCIA;data=" + Date
               + ";hora=" + Time
               + ";barra=" + CurrentBar
               + ";seq=" + v_Seq
               + ";posicao=" + PositionQty
               + ";antes=" + v_Antes
               + ";depois=" + v_Anterior);
  end;
end;
