{ S1: validade das protecoes sem renovacao. Somente Backtest OHLC. }
input
  p_Data(1261026);
  p_Entrada(1315);
  p_Protecao(1316);
  p_Cancela(1321);
  p_Zera(1322);
  p_Fim(1323);
  p_Distancia(2000);
  p_Folga(500);

var
  v_Seq, v_Pendentes : Integer;
  v_EntradaEnviada, v_ProtecaoEnviada, v_Cancelou, v_Zerou : Boolean;
  v_Alvo, v_Gatilho, v_Limite : Float;

begin
  if (Date = p_Data) and (Time >= p_Entrada) and (Time <= p_Fim) then
  begin
      v_Seq := v_Seq + 1;
      if HasPendingOrders then v_Pendentes := 1 else v_Pendentes := 0;
      ConsoleLog("SONDA_S1;AVALIACAO"
        + ";data=" + FloatToString(Date, 0)
        + ";hora=" + FloatToString(Time, 0)
        + ";barra=" + FloatToString(CurrentBar, 0)
        + ";seq=" + FloatToString(v_Seq, 0)
        + ";posicao=" + FloatToString(PositionQty, 0)
        + ";pendentes=" + FloatToString(v_Pendentes, 0), clYellow);

    if (Time = p_Entrada) and not HasPosition and not HasPendingOrders
      and not v_EntradaEnviada then
    begin
      v_EntradaEnviada := True;
      ConsoleLog("SONDA_S1;SOLICITA_COMPRA;seq=" + FloatToString(v_Seq, 0), clYellow);
      BuyAtMarket(1);
    end;

    if (Time = p_Protecao) and IsBought and not v_ProtecaoEnviada then
    begin
      v_ProtecaoEnviada := True;
      v_Alvo := BuyPrice + p_Distancia;
      v_Gatilho := BuyPrice - p_Distancia;
      v_Limite := v_Gatilho - p_Folga;
      ConsoleLog("SONDA_S1;SOLICITA_ALVO;seq=" + FloatToString(v_Seq, 0)
        + ";limite=" + FloatToString(v_Alvo, 0), clYellow);
      SellToCoverLimit(v_Alvo, 1);
      ConsoleLog("SONDA_S1;SOLICITA_STOP;seq=" + FloatToString(v_Seq, 0)
        + ";gatilho=" + FloatToString(v_Gatilho, 0)
        + ";limite=" + FloatToString(v_Limite, 0), clYellow);
      SellToCoverStop(v_Gatilho, v_Limite, 1);
    end;

    if (Time = p_Cancela) and HasPendingOrders and not v_Cancelou then
    begin
      v_Cancelou := True;
      ConsoleLog("SONDA_S1;SOLICITA_CANCELAMENTO_LIMPEZA;seq=" + FloatToString(v_Seq, 0), clYellow);
      CancelPendingOrders;
    end;
    if (Time = p_Zera) and HasPosition and not v_Zerou then
    begin
      v_Zerou := True;
      ConsoleLog("SONDA_S1;SOLICITA_ZERAGEM_LIMPEZA;seq=" + FloatToString(v_Seq, 0), clYellow);
      ClosePosition;
    end;
  end;
end;
